<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.sanderrobijns.reach</string>
<key>CFBundleName</key><string>Reach</string>
<key>CFBundleDisplayName</key><string>Reach</string>
<key>CFBundleExecutable</key><string>Reach</string>
<key>CFBundleIconFile</key><string>AppIcon</string>
<key>CFBundleIconName</key><string>AppIcon</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1</string>
<key>CFBundleVersion</key><string>__BUILD__</string>
<key>LSMinimumSystemVersion</key><string>26.0</string>
<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
<key>NSHighResolutionCapable</key><true/>
<key>LSUIElement</key><true/>
<key>NSContactsUsageDescription</key><string>Reach finds your contacts as you type a name, shows their details in the launcher, and starts emails to them.</string>
<key>NSAppleEventsUsageDescription</key><string>Reach asks Finder to show Get Info and empty the Trash, asks macOS to log out, restart or shut down, and asks your terminal app to run the shell commands you type.</string>
<key>NSPrincipalClass</key><string>NSApplication</string>
</dict></plist>
